 "cells": [
  {
   "cell_type": "markdown",
   "id": "d29bd4e0",
   "metadata": {},
   "source": [
    "# 03. Exploratory Data Analysis\n",
    "\n",
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d8936808",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import missingno as msno\n",
    "\n",
    "sns.set_theme(style='whitegrid')\n",
    "df = pd.read_csv('../data/processed/panel_clean.csv')\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9091f8f5",
   "metadata": {},
   "source": [
    "## 1. Coverage\n",
    "\n",
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "59f3e52a",
   "metadata": {},
   "outputs": [],
   "source": [
    "coverage = (df.set_index(['name', 'year'])[['syndicated_loans_gdp', 'corporate_bonds_gdp']]\n",
    "            .notna().groupby(level=0).mean())\n",
    "coverage.sort_values('syndicated_loans_gdp', ascending=False).head(15)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7e0764c6",
   "metadata": {},
   "outputs": [],
   "source": [
    "msno.matrix(df[['syndicated_loans_gdp', 'corporate_bonds_gdp', 'banking_crisis_dummy']])\n",
    "plt.title('Missingness pattern')\n",
    "plt.tight_layout()\n",
    "plt.savefig('../outputs/figures/missingness.png', dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8b6898d9",
   "metadata": {},
   "source": [
    "## 2. Univariate distributions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "edaf0299",
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
    "sns.histplot(df['syndicated_loans_gdp'].dropna(), kde=True, ax=axes[0])\n",
    "axes[0].set_title('Syndicated loans / GDP (%)')\n",
    "sns.histplot(df['corporate_bonds_gdp'].dropna(), kde=True, ax=axes[1])\n",
    "axes[1].set_title('Corporate bonds / GDP (%)')\n",
    "plt.tight_layout()\n",
    "plt.savefig('../outputs/figures/univariate_dist.png', dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e54a14c5",
   "metadata": {},
   "source": [
    "## 3. Time trends\n",
    "\n",
    "Global average of each ratio by year."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "660b08c9",
   "metadata": {},
   "outputs": [],
   "source": [
    "trend = df.groupby('year')[['syndicated_loans_gdp', 'corporate_bonds_gdp']].mean()\n",
    "trend.plot(figsize=(10, 5), marker='o')\n",
    "plt.title('Global average financing ratios over time')\n",
    "plt.ylabel('% of GDP')\n",
    "plt.axvspan(2008, 2009, color='red', alpha=0.1, label='GFC')\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.savefig('../outputs/figures/time_trend.png', dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4c154daa",
   "metadata": {},
   "source": [
    "## 4. Cross-country comparison by income group"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7dd1c591",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(10, 5))\n",
    "sns.boxplot(data=df, x='incomeLevel', y='corporate_bonds_gdp')\n",
    "plt.title('Corporate bond issuance / GDP by income group')\n",
    "plt.xticks(rotation=30)\n",
    "plt.tight_layout()\n",
    "plt.savefig('../outputs/figures/income_group_boxplot.png', dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "fdfe660e",
   "metadata": {},
   "source": [
    "## 5. Crisis vs. non-crisis comparison\n",
    "\n",
    "This is the key exploratory result: do the two ratios look different in banking-crisis years vs. non-crisis years?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1a2d0f66",
   "metadata": {},
   "outputs": [],
   "source": [
    "crisis_compare = (df.dropna(subset=['banking_crisis_dummy'])\n",
    "                    .groupby('banking_crisis_dummy')[['syndicated_loans_gdp', 'corporate_bonds_gdp']]\n",
    "                    .describe().T)\n",
    "crisis_compare"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6fbdc488",
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
    "for ax, col in zip(axes, ['syndicated_loans_gdp', 'corporate_bonds_gdp']):\n",
    "    sns.boxplot(data=df.dropna(subset=['banking_crisis_dummy']), x='banking_crisis_dummy', y=col, ax=ax)\n",
    "    ax.set_xticklabels(['No crisis', 'Crisis'])\n",
    "plt.tight_layout()\n",
    "plt.savefig('../outputs/figures/crisis_comparison.png', dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bca9881f",
   "metadata": {},
   "source": [
    "## 6. Correlation between the two financing ratios"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4e7bb254",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(7, 6))\n",
    "sns.scatterplot(data=df, x='syndicated_loans_gdp', y='corporate_bonds_gdp',\n",
    "                 hue='banking_crisis_dummy', alpha=0.6)\n",
    "plt.title('Syndicated loans vs. corporate bonds (% of GDP)')\n",
    "plt.tight_layout()\n",
    "plt.savefig('../outputs/figures/scatter_correlation.png', dpi=150)\n",
    "plt.show()\n",
    "\n",
    "df[['syndicated_loans_gdp', 'corporate_bonds_gdp']].corr()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "117be73e",
   "metadata": {},
   "source": [
    "## 7. Event-window view\n",
    "\n",
    "Pick a couple of well-known crisis countries/years and look at both ratios in the years surrounding the crisis."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "746be60e",
   "metadata": {},
   "outputs": [],
   "source": [
    "event_countries = ['United States', 'United Kingdom']  # adjust to taste\n",
    "event_df = df[df['name'].isin(event_countries)]\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 5))\n",
    "for country, g in event_df.groupby('name'):\n",
    "    ax.plot(g['year'], g['syndicated_loans_gdp'], marker='o', label=f'{country} — loans')\n",
    "    ax.plot(g['year'], g['corporate_bonds_gdp'], marker='s', linestyle='--', label=f'{country} — bonds')\n",
    "ax.axvspan(2007, 2009, color='red', alpha=0.1, label='GFC window')\n",
    "ax.legend()\n",
    "ax.set_ylabel('% of GDP')\n",
    "plt.tight_layout()\n",
    "plt.savefig('../outputs/figures/event_window.png', dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c03598c0",
   "metadata": {},
